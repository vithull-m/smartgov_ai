# Database Configuration (SQLite default for local development, MySQL for production)
DATABASE_URL=sqlite:///./smartgov_ai.db
# DATABASE_URL=mysql+pymysql://smartgov_user:smartgov_pass@localhost:3306/smartgov_ai

# Security & Tokens
SECRET_KEY=change-this-to-a-secure-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hosted AI Model Configuration
# Supports official OpenAI API or OpenAI-compatible endpoints (Groq, Together AI, Azure OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# CORS Origins
CORS_ORIGINS=http://localhost:5173

# Government Scheme Update Service Configuration
SCHEME_UPDATE_INTERVAL_HOURS=24
SCHEME_UPDATE_SOURCE_URL=https://www.myscheme.gov.in/
ADMIN_API_KEY=smartgov-admin-secure-key

# Speech & Voice Settings (Browser Web Speech API & Cloud Fallbacks)
SPEECH_SERVICE_ENABLED=True
TTS_DEFAULT_VOICE=default

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="SmartGov AI"
SMTP_TLS=True
